---
import SiteLayout from '../../layouts/SiteLayout.astro';
import EvidenceLabel from '../../components/EvidenceLabel.astro';
import { getPlaybooks, articleHref } from '../../lib/content';

const playbooks = await getPlaybooks('zh');
---
<SiteLayout
  title="Playbooks"
  description="面向一人公司的端到端 playbook：用哪套工具、按什么顺序，以及建议的时间预算。"
  canonicalPath="/zh/playbooks/"
  locale="zh"
  ogImage="/og/playbook-48h-mvp.png"
>
  <h1>Playbooks</h1>
  <p class="lede">端到端工作流：用哪些工具、什么顺序、时钟跑多久。</p>
  {playbooks.length === 0 ? (
    <div class="empty-state">暂无已发布的 playbook。</div>
  ) : (
    <ul class="list-plain">
      {playbooks.map((a) => (
        <li>
          <h2 style="margin:0 0 0.35rem;font-size:1.15rem">
            <a href={articleHref(a.data.slug, 'zh')}>{a.data.title}</a>
          </h2>
          <p style="margin:0">{a.data.summary}</p>
          <p class="meta" style="margin:0.4rem 0 0">
            <EvidenceLabel evidence={a.data.evidence} locale="zh" />
            {' · '}
            {a.data.stage}
            {' · '}
            更新于 {a.data.updated}
          </p>
        </li>
      ))}
    </ul>
  )}
</SiteLayout>
