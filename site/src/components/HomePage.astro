---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from './Icon.astro';
import EvidenceLabel from './EvidenceLabel.astro';
import { site, type Locale } from '../data/site';
import { getPublishedChangelog, getStackCards, articleHref } from '../lib/content';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const cards = await getStackCards(locale);
const [latest] = await getPublishedChangelog(locale);
const home = `/${locale}/`;
const allDocumentationBacked = cards.length > 0 && cards.every((card) => card.data.evidence === 'documentation-backed');
const copy = zh ? {
  eyebrow: '一人公司的实践参考',
  title: '下一步，选对你的 Agent。',
  intro: '用 Claude Code、Codex 与 Grok Build，完成调研、构建与销售的实用指南。',
  stack: '主工具栈', comparison: '完整对照表', agent: '工具', bestFor: '擅长什么', guide: '指南', read: '阅读指南',
  evidence: '基于文档的实践指南', playbook: '用 48 小时，从想法走向 MVP。', cta: '从 48 小时 MVP Playbook 开始',
  research: '调研', build: '构建', sell: '销售', latest: '最近更新', empty: '首条周更即将到来。',
} : {
  eyebrow: 'The solo builder’s reference',
  title: 'The right agent for the next step.',
  intro: 'Practical guides to research, build, and sell with Claude Code, Codex, and Grok Build.',
  stack: 'Primary stack', comparison: 'Full comparison', agent: 'Agent', bestFor: 'Best for', guide: 'Guide', read: 'Read guide',
  evidence: 'Documentation-backed guidance', playbook: 'Go from idea to MVP in 48 hours.', cta: 'Start the 48-hour MVP playbook',
  research: 'Research', build: 'Build', sell: 'Sell', latest: 'Latest update', empty: 'First weekly update coming soon.',
};
---
<SiteLayout locale={locale} title={site.name} description={copy.intro} canonicalPath={home} wide={true}>
  <section class="home-intro" aria-labelledby="home-heading">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1 id="home-heading">{copy.title}</h1>
    <p class="lede">{copy.intro}</p>
  </section>
  <section class="home-stack" aria-labelledby="stack-heading">
    <div class="section-heading">
      <h2 id="stack-heading">{copy.stack}</h2>
      <a class="text-link" href={`${home}stack/`}>{copy.comparison}<Icon name="arrow" /></a>
    </div>
    <table class="home-stack__table">
      <thead><tr><th scope="col">{copy.agent}</th><th scope="col">{copy.bestFor}</th><th scope="col">{copy.guide}</th></tr></thead>
      <tbody>
        {cards.map((card) => (
          <tr>
            <th scope="row">
              <a href={articleHref(card.data.slug, locale)}>{card.data.title}</a>
              {card.data.toolAvailability !== 'active' && <span class={`badge badge--${card.data.toolAvailability}`}>{card.data.toolAvailability}</span>}
            </th>
            <td>{card.data.bestFor ?? card.data.summary}</td>
            <td><a class="text-link" href={articleHref(card.data.slug, locale)} aria-label={`${copy.read}: ${card.data.title}`}>{copy.read}<Icon name="arrow" /></a></td>
          </tr>
        ))}
      </tbody>
    </table>
    {allDocumentationBacked ? <p class="stack-evidence">{copy.evidence}</p> : (
      <ul class="stack-evidence stack-evidence--mixed">
        {cards.map((card) => <li>{card.data.title}: <EvidenceLabel evidence={card.data.evidence} locale={locale} /></li>)}
      </ul>
    )}
  </section>
  <section class="playbook-callout" aria-label={zh ? '从这里开始' : 'Start here'}>
    <h2>{copy.playbook}</h2>
    <a class="primary-cta" href={articleHref('48h-mvp-agent-stack', locale)}>{copy.cta}</a>
  </section>
  <div class="home-bottom">
    <nav class="journey-links" aria-label={zh ? '调研、构建与销售' : 'Research, build, and sell'}>
      <a href={`${home}research/`}>{copy.research}<Icon name="arrow" /></a>
      <a href={`${home}build/`}>{copy.build}<Icon name="arrow" /></a>
      <a href={`${home}sell/`}>{copy.sell}</a>
    </nav>
    <div class="latest-update">
      <span class="eyebrow">{copy.latest}</span>
      {latest ? <a href={`${home}changelog/#${latest.data.slug}`}><time datetime={latest.data.date}>{latest.data.date}</time><span>{latest.data.title}</span></a> : <p>{copy.empty}</p>}
    </div>
  </div>
</SiteLayout>
