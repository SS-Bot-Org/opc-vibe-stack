---
import { site, type Locale } from '../data/site';
import { navFor, uiFor } from '../lib/i18n';
import LocaleSwitcher from './LocaleSwitcher.astro';
import SearchControl from './SearchControl.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath: string;
  locale?: Locale | string;
}
const { currentPath, locale = 'en' } = Astro.props;
const nav = navFor(locale);
const ui = uiFor(locale);
const home = locale === 'zh' ? '/zh/' : '/en/';

function isCurrent(href: string): boolean {
  if (href === home) return currentPath === home || currentPath === home.slice(0, -1);
  return currentPath === href || currentPath.startsWith(href);
}
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={home}>{site.name}</a>
    <details class="header-nav" open data-header-nav>
      <summary aria-expanded="true">{locale === 'zh' ? '导航' : 'Menu'}</summary>
    <nav aria-label={ui.primaryNav}>
      <ul class="nav">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    </details>
    <div class="header-tools">
      <details class="header-search" open data-header-search>
        <summary aria-expanded="true">{locale === 'zh' ? '搜索' : 'Search'}</summary>
        <SearchControl locale={locale === 'zh' ? 'zh' : 'en'} />
      </details>
      <ThemeToggle locale={locale} />
      <LocaleSwitcher currentPath={currentPath} locale={locale} />
    </div>
  </div>
</header>

<script>
  const media = window.matchMedia('(max-width: 799px)');
  const disclosures = document.querySelectorAll<HTMLDetailsElement>('[data-header-nav], [data-header-search]');
  function sync() { disclosures.forEach((el) => { el.open = !media.matches; el.querySelector('summary')?.setAttribute('aria-expanded', String(el.open)); }); }
  sync();
  media.addEventListener('change', sync);
  disclosures.forEach((el) => el.addEventListener('toggle', () => {
    el.querySelector('summary')?.setAttribute('aria-expanded', String(el.open));
    if (media.matches && el.open) disclosures.forEach((other) => { if (other !== el) other.open = false; });
  }));
</script>
