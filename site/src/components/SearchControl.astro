---
import { uiFor } from '../lib/i18n';
interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const ui = uiFor(locale);
const indexUrl = `/${locale}/search-index.json`;
---
<div class="search" data-search data-index-url={indexUrl} data-empty={ui.searchEmpty} data-error={ui.searchError} data-results={ui.searchResults}>
  <label class="visually-hidden" for="site-search">{ui.searchLabel}</label>
  <input
    id="site-search"
    class="search__input"
    type="search"
    name="q"
    placeholder={ui.searchPlaceholder}
    autocomplete="off"
    aria-controls="search-results"
    aria-expanded="false"
    data-search-input
  />
  <p class="search__status meta" role="status" aria-live="polite" aria-atomic="true" data-search-status></p>
  <ul id="search-results" class="search__results list-plain" data-search-results hidden></ul>
</div>
<script>
  import { createSearch } from '../lib/search.mjs';
  const root = document.querySelector<HTMLElement>('[data-search]');
  const input = root?.querySelector<HTMLInputElement>('[data-search-input]');
  const status = root?.querySelector<HTMLElement>('[data-search-status]');
  const list = root?.querySelector<HTMLUListElement>('[data-search-results]');
  if (root && input && status && list) {
    const controller = createSearch(async () => {
      const response = await fetch(root.dataset.indexUrl!, { credentials: 'same-origin' });
      if (!response.ok) throw new Error('Search unavailable');
      return response.json();
    }, (items: { title: string; url: string }[], query: string) => {
      list.replaceChildren();
      list.hidden = !items.length;
      input.setAttribute('aria-expanded', String(!!items.length));
      status.textContent = !query ? '' : items.length ? `${root.dataset.results} (${items.length})` : root.dataset.empty!;
      for (const item of items) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = item.url;
        a.textContent = item.title;
        li.append(a);
        list.append(li);
      }
    }, () => { status.textContent = root.dataset.error!; });
    input.addEventListener('input', () => { void controller.update(input.value); });
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { controller.dismiss(); input.focus(); }
      if (event.key === 'ArrowDown' && event.target === input) {
        const first = list.querySelector('a');
        if (first) { event.preventDefault(); first.focus(); }
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !root.contains(event.target)) controller.dismiss();
    });
    root.addEventListener('focusout', () => {
      queueMicrotask(() => { if (!root.contains(document.activeElement)) controller.dismiss(); });
    });
  }
</script>
