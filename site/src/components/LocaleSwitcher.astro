---
import type { Locale } from '../data/site';
import { readInventory, alternateRoutes } from '../lib/inventory.mjs';
import { uiFor } from '../lib/i18n';

interface Props {
  currentPath: string;
  locale: Locale | string;
}
const { currentPath, locale } = Astro.props;
const ui = uiFor(locale);

const { routes } = await readInventory();
const candidates = alternateRoutes(routes, currentPath);
const other = locale === 'zh' ? 'en' : 'zh';
const target = candidates.find((candidate) => candidate.locale === other);
const isArticle = /^\/(en|zh)\/articles\/[^/]+\/$/.test(currentPath);
const unavailable = isArticle && !target;
const href = target?.href ?? `/${other}/`;
---
<div class:list={['locale-switcher', unavailable && 'locale-switcher--unavailable']} aria-label={ui.localeSwitcher}>
  {unavailable ? (
    <span class="meta" data-translation-unavailable>{other === 'zh' ? ui.notInZh : ui.notInEn}</span>
  ) : (
    <a href={href} lang={other === 'zh' ? 'zh-Hans' : 'en'}>{other === 'zh' ? ui.langZh : ui.langEn}</a>
  )}
</div>
