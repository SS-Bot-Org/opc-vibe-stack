---
import { uiFor } from '../lib/i18n';
interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const ui = uiFor(locale);
const indexUrl = `/${locale}/search-index.json`;
---
<div class="search" data-search data-index-url={indexUrl}>
  <label class="visually-hidden" for="site-search">{ui.searchLabel}</label>
  <input
    id="site-search"
    class="search__input"
    type="search"
    name="q"
    placeholder={ui.searchPlaceholder}
    autocomplete="off"
    data-search-input
  />
  <p class="search__status meta" data-search-status hidden></p>
  <ul class="search__results list-plain" data-search-results hidden></ul>
</div>
<script is:inline define:vars={{ emptyMsg: ui.searchEmpty, errorMsg: ui.searchError, resultsLabel: ui.searchResults }}>
  (function () {
    var root = document.querySelector('[data-search]');
    if (!root) return;
    var input = root.querySelector('[data-search-input]');
    var status = root.querySelector('[data-search-status]');
    var list = root.querySelector('[data-search-results]');
    var indexUrl = root.getAttribute('data-index-url');
    var cache = null;
    var failed = false;

    function showStatus(text, isError) {
      status.hidden = !text;
      status.textContent = text || '';
      status.classList.toggle('search__status--error', !!isError);
    }

    function rank(items, q) {
      var query = q.trim().toLowerCase();
      if (!query) return [];
      var scored = [];
      for (var i = 0; i < items.length; i++) {
        var it = items[i];
        var title = (it.title || '').toLowerCase();
        var tags = (it.tags || []).map(function (t) { return String(t).toLowerCase(); });
        var score = 0;
        if (title === query) score = 100;
        else if (title.indexOf(query) === 0) score = 80;
        else if (title.indexOf(query) !== -1) score = 60;
        else if (tags.some(function (t) { return t === query || t.indexOf(query) !== -1; })) score = 40;
        else if ((it.summary || '').toLowerCase().indexOf(query) !== -1) score = 20;
        if (score) scored.push({ score: score, item: it });
      }
      scored.sort(function (a, b) { return b.score - a.score; });
      return scored.slice(0, 8).map(function (s) { return s.item; });
    }

    function render(items) {
      list.innerHTML = '';
      if (!items.length) {
        list.hidden = true;
        showStatus(emptyMsg, false);
        return;
      }
      showStatus(resultsLabel + ' (' + items.length + ')', false);
      list.hidden = false;
      for (var i = 0; i < items.length; i++) {
        var it = items[i];
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = it.url;
        a.textContent = it.title;
        li.appendChild(a);
        if (it.tags && it.tags.length) {
          var meta = document.createElement('span');
          meta.className = 'meta';
          meta.textContent = ' · ' + it.tags.join(', ');
          li.appendChild(meta);
        }
        list.appendChild(li);
      }
    }

    function ensureIndex(cb) {
      if (failed) {
        showStatus(errorMsg, true);
        list.hidden = true;
        return;
      }
      if (cache) return cb(cache);
      fetch(indexUrl, { credentials: 'same-origin' })
        .then(function (r) {
          if (!r.ok) throw new Error('bad status');
          return r.json();
        })
        .then(function (data) {
          cache = Array.isArray(data) ? data : (data.items || []);
          cb(cache);
        })
        .catch(function () {
          failed = true;
          showStatus(errorMsg, true);
          list.hidden = true;
        });
    }

    input.addEventListener('input', function () {
      var q = input.value;
      if (!q.trim()) {
        list.hidden = true;
        showStatus('', false);
        return;
      }
      ensureIndex(function (items) {
        render(rank(items, q));
      });
    });
  })();
</script>
