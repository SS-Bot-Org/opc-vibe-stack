---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { site } from '../../data/site';
import { getPublishedChangelog, getStackCards, articleHref } from '../../lib/content';

const cards = await getStackCards('en');
const changelog = await getPublishedChangelog('en');
const latest = changelog[0];
---
<SiteLayout locale="en" title={site.name} description={site.tagline} canonicalPath="/en/" wide={true}>
  <section class="hero">
    <h1>{site.name}</h1>
    <p class="lede">{site.tagline}</p>
    <p>
      Executable best practices for one-person companies: which agent for which stage,
      how to wire a pipeline, and how to sell—kept current from weekly Vibe Coding briefings.
    </p>
  </section>

  <section aria-labelledby="path-heading" style="margin-top:2rem">
    <h2 id="path-heading">Research → Build → Sell</h2>
    <div class="card-grid">
      <a class="card" href="/en/research/" style="text-decoration:none;color:inherit">
        <h3>Research</h3>
        <p class="meta">Spec first. Clarify the problem before the agent rewrites half the repo.</p>
      </a>
      <a class="card" href="/en/build/" style="text-decoration:none;color:inherit">
        <h3>Build</h3>
        <p class="meta">Rules, hooks, and verification loops—not vibes alone.</p>
      </a>
      <a class="card" href="/en/sell/" style="text-decoration:none;color:inherit">
        <h3>Sell</h3>
        <p class="meta">Landing page, demo, distribution. Ship something people can buy.</p>
      </a>
    </div>
  </section>

  <section aria-labelledby="stack-heading" style="margin-top:2.5rem">
    <h2 id="stack-heading">Primary stack</h2>
    <p><a href="/en/stack/">See the full division-of-labor table</a>.</p>
    <div class="card-grid">
      {cards.map((c) => (
        <a class="card" href={articleHref(c.data.slug)} style="text-decoration:none;color:inherit">
          <h3>{c.data.title}</h3>
          <p class="meta">{c.data.summary}</p>
        </a>
      ))}
    </div>
  </section>

  <section aria-labelledby="m3-heading" style="margin-top:2.5rem">
    <h2 id="m3-heading">Playbooks &amp; hardware</h2>
    <div class="card-grid">
      <a class="card" href="/en/playbooks/" style="text-decoration:none;color:inherit">
        <h3>Playbooks</h3>
        <p class="meta">End-to-end loops with toolchain and timebox.</p>
      </a>
      <a class="card" href="/en/hardware/" style="text-decoration:none;color:inherit">
        <h3>Hardware</h3>
        <p class="meta">Firmware vs companion app; verify-yourself checklist.</p>
      </a>
    </div>
  </section>

  <section aria-labelledby="update-heading" style="margin-top:2.5rem">
    <h2 id="update-heading">Latest update</h2>
    {latest ? (
      <div class="card">
        <p class="meta">{latest.data.date}</p>
        <h3><a href={`/en/changelog/#${latest.data.slug}`}>{latest.data.title}</a></h3>
        <p>{latest.data.summary}</p>
      </div>
    ) : (
      <div class="empty-state">
        First weekly update coming soon. Soft launch content is documentation-backed seed guidance;
        the first briefing-derived changelog lands at M2.
      </div>
    )}
  </section>
</SiteLayout>
