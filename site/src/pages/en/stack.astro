---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getStackCards, articleHref, featuredToolNames } from '../../lib/content';
import { stackDocumentTitle } from '../../lib/seo.mjs';

const cards = await getStackCards('en');
const title = stackDocumentTitle(featuredToolNames(cards), 'en');
---
<SiteLayout
  locale="en"
  title={title}
  description="How a one-person company can split work across the current featured coding agents, with availability tracked separately from article status."
  canonicalPath="/en/stack/"
  wide={true}
>
  <h1>Stack</h1>
  <p class="lede">
    Current featured tools, with availability tracked separately from article status. This comparison follows the tools listed this week, not a permanent vendor ranking.
  </p>

  <div class="table-wrap" tabindex="0" role="region" aria-label="Agent comparison, scroll horizontally if needed">
    <table>
      <thead>
        <tr>
          <th>Tool</th>
          <th>Best stage</th>
          <th>Best for</th>
          <th>Poor fit</th>
          <th>Caveats</th>
          <th>Availability</th>
        </tr>
      </thead>
      <tbody>
        {cards.map((c) => (
          <tr>
            <td>
              <a href={articleHref(c.data.slug)}>{c.data.title}</a>
              {c.data.subtitle && <p class="tool-subtitle">{c.data.subtitle}</p>}
            </td>
            <td>{c.data.stage}</td>
            <td>{c.data.bestFor}</td>
            <td>{c.data.poorFit}</td>
            <td>{c.data.caveats}</td>
            <td>
              <span class={`badge badge--${c.data.toolAvailability ?? 'active'}`}>
                {c.data.toolAvailability ?? 'active'}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <section class="stack-cards" style="margin-top:2rem" aria-label="Tool cards">
    {cards.map((c) => (
      <article class="card">
        <h2><a href={articleHref(c.data.slug)}>{c.data.title}</a></h2>
        {c.data.subtitle && <p class="tool-subtitle">{c.data.subtitle}</p>}
        <p>{c.data.summary}</p>
        <p class="meta">Updated {c.data.updated}</p>
      </article>
    ))}
  </section>
</SiteLayout>
