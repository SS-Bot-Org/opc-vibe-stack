# Example Nginx site for OPC Vibe Stack (Ubuntu VPS).
# Document root should be the `current` symlink to a release directory.

server {
    listen 80;
    listen [::]:80;
    server_name opcvibestack.com www.opcvibestack.com;

    # Prefer Cloudflare Full (strict) with origin cert; this block is HTTP origin sketch.
    root /srv/opcvibestack/current;
    error_page 404 /404.html;

    location = / {
        return 301 /en/;
    }

    location / {
        try_files $uri $uri/ $uri/index.html =404;
    }

    location /_astro/ {
        # M1: assets live inside the release. When using shared/_astro later, alias there.
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location ~* \.(html|xml|txt|json)$ {
        add_header Cache-Control "no-cache";
    }
}
